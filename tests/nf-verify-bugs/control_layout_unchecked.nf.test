nextflow_workflow {

    name "nf-verify bug: a control's read layout is never checked against its treatment's"
    script "../../workflows/atacseq.nf"
    workflow "ATACSEQ"
    config "./nextflow.config"
    tag "nf-verify-bug"
    tag "nf-verify-bug-control-layout-unchecked"

    // nf-verify R1 (meta agreement), proved in Lean: neither bin/check_samplesheet.py nor workflows/atacseq.nf:365-381
    // compares single_end of a treatment and its control, and MACS3 reads both with the treatment's --format
    // (BAM vs BAMPE). assets/samplesheet_with_control.csv pairs single-end TREATED_A with paired-end INPUT_A.
    // https://github.com/seqeralabs/nf-verify/blob/integration/docs/findings.md#findings
    test("a single-end treatment is not peak-called against a paired-end control") {

        options "-stub"

        when {
            params {
                load("$baseDir/tests/nf-verify-bugs/stub_params.json")
                outdir       = "$outputDir"
                with_control = true
            }
            workflow {
                def sheet = NfVerifyBugs.stageSamplesheet("${baseDir}/tests/nf-verify-bugs/samplesheets/layout_mismatch.csv", "$outputDir")
                NfVerifyBugs.atacseqInputs(sheet, "$outputDir")
            }
        }

        then {
            def rejected = NfVerifyBugs.rejected(workflow.success, workflow.stdout + workflow.stderr, /(?i)control/)
            def mismatched = NfVerifyBugs.tasks("${launchDir}/work", /:MACS3_CALLPEAK/)
                .findAll { t -> t.meta.id.startsWith('TREATED') && t.inputs.any { f -> f.startsWith('INPUT') } }
            assertAll(
                // Either outcome is a fix: the run is rejected with a message about the control, or it succeeds without the mismatched pair.
                { assert workflow.success || rejected : "run failed for another reason; see the Nextflow output" },
                { assert mismatched.isEmpty() : "single-end treatment peak-called with paired-end control: ${mismatched*.name}" }
            )
        }
    }
}
