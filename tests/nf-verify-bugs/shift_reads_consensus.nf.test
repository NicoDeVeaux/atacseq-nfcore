nextflow_workflow {

    name "nf-verify bug: with --shift_reads the two consensus count matrices count different reads"
    script "../../workflows/atacseq.nf"
    workflow "ATACSEQ"
    config "./nextflow.config"
    tag "nf-verify-bug"
    tag "nf-verify-bug-shift-reads-consensus"

    // nf-verify audit: with --shift_reads, the merged-library consensus counts the shifted, 0-120 bp filtered BAMs
    // (workflows/atacseq.nf:325-335, 436-438), but the merged-replicate consensus counts ch_merged_library_replicate_bam,
    // built from the unshifted MERGED_LIBRARY_FILTER_BAM output (:498-515, 615-617).
    // https://github.com/seqeralabs/nf-verify/blob/integration/docs/findings.md#findings
    test("both consensus featureCounts runs count the same library BAMs under --shift_reads") {

        options "-stub"

        when {
            params {
                load("$baseDir/tests/nf-verify-bugs/stub_params.json")
                outdir               = "$outputDir"
                shift_reads          = true
                skip_consensus_peaks = false
            }
            workflow {
                def sheet = NfVerifyBugs.stageSamplesheet("${baseDir}/tests/nf-verify-bugs/samplesheets/zero_peak_consensus.csv", "$outputDir")
                NfVerifyBugs.atacseqInputs(sheet, "$outputDir")
            }
        }

        then {
            def bams = { regex -> NfVerifyBugs.tasks("${launchDir}/work", regex)*.inputs.flatten().findAll { f -> f.endsWith('.bam') }.sort() }
            def library   = bams(/MERGED_LIBRARY_CONSENSUS_PEAKS:SUBREAD_FEATURECOUNTS/)
            def replicate = bams(/MERGED_REPLICATE_CONSENSUS_PEAKS:SUBREAD_FEATURECOUNTS/)
            assertAll(
                { assert workflow.success },
                { assert library.size() == 4 && library.every { f -> f.contains('shifted') } : "merged-library consensus counted ${library}" },
                { assert replicate == library : "merged-replicate consensus counted ${replicate}, merged-library consensus ${library}" }
            )
        }
    }
}
