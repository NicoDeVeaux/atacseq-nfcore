/*
    Test-only instrumentation for the nf-verify bug pins (stub runs). Changes no pipeline logic:
    - records each task's meta and ext.args in .nf_verify_meta.json, so tests can read what reached a process;
    - gives MACS3 stub peak files one peak, except for ids in params.nf_verify_zero_peak_ids,
      so the pipeline's zero-peak filters see both kinds of library.
*/

params {
    nf_verify_zero_peak_ids = ''
}

process {
    withName: '.*(DEEPTOOLS_PLOTFINGERPRINT|ATAQV_ATAQV|SUBREAD_FEATURECOUNTS|PICARD_MERGESAMFILES_.*|DEEPTOOLS_ALIGNMENTSIEVE)' {
        afterScript = { "echo '${groovy.json.JsonOutput.toJson([meta: meta, ext_args: task.ext.args ?: ''])}' > .nf_verify_meta.json" }
    }
    withName: '.*:MACS3_CALLPEAK' {
        afterScript = {
            // One broadPeak-format line, named like MACS3 names peaks (<prefix>_peak_1)
            def peak = meta.id.toString() in params.nf_verify_zero_peak_ids.tokenize(',') ? '' : 'chr1\\t0\\t4\\t%s_peak_1\\t10\\t.\\t2\\t3\\t1\\n'
            "echo '${groovy.json.JsonOutput.toJson([meta: meta, ext_args: task.ext.args ?: ''])}' > .nf_verify_meta.json; for f in *.narrowPeak *.broadPeak; do [ -e \"\$f\" ] && printf '${peak}' \"\${f%.*}\" > \"\$f\"; done; true"
        }
    }
}
