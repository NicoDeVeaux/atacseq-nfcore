nextflow_workflow {

    name "nf-verify bug: a single-replicate control drops merged-replicate peak calls"
    script "../../workflows/atacseq.nf"
    workflow "ATACSEQ"
    config "./nextflow.config"
    tag "nf-verify-bug"
    tag "nf-verify-bug-single-replicate-control"

    // nf-verify R2 (silent drops): workflows/atacseq.nf:509-514 keeps only samples with >1 replicate for the
    // replicate merge, so a control with one replicate never gets a merged BAM and the combine at :578 drops
    // every treatment that names it. assets/samplesheet_with_control.csv has this shape (INPUT_A, 1 replicate).
    // https://github.com/seqeralabs/nf-verify/blob/integration/docs/rules/R2-silent-drops.md
    test("merged-replicate MACS3 runs for each treatment of a single-replicate control") {

        options "-stub"

        when {
            params {
                load("$baseDir/tests/nf-verify-bugs/stub_params.json")
                outdir       = "$outputDir"
                with_control = true
            }
            workflow {
                def sheet = NfVerifyBugs.stageSamplesheet("${baseDir}/tests/nf-verify-bugs/samplesheets/single_replicate_control.csv", "$outputDir")
                NfVerifyBugs.atacseqInputs(sheet, "$outputDir")
            }
        }

        then {
            def mrp = NfVerifyBugs.tasks("${launchDir}/work", /MERGED_REPLICATE_CALL_ANNOTATE_PEAKS:MACS3_CALLPEAK/)
            assertAll(
                { assert workflow.success },
                { assert mrp*.meta*.id.sort() == [ 'TREATED_A', 'UNTREATED_A' ] : "merged-replicate MACS3 ran for ${mrp*.meta*.id}" },
                { assert mrp.every { t -> t.inputs.any { f -> f.startsWith('INPUT_A') } } : "control BAMs staged: ${mrp*.inputs}" }
            )
        }
    }

    test("the shipped assets/samplesheet_with_control.csv gets merged-replicate peak calls") {

        options "-stub"

        when {
            params {
                load("$baseDir/tests/nf-verify-bugs/stub_params.json")
                outdir       = "$outputDir"
                with_control = true
            }
            workflow {
                def sheet = NfVerifyBugs.stageSamplesheet("${baseDir}/assets/samplesheet_with_control.csv", "$outputDir")
                NfVerifyBugs.atacseqInputs(sheet, "$outputDir")
            }
        }

        then {
            // This samplesheet also pairs single-end TREATED_A with paired-end INPUT_A (see control_layout_unchecked.nf.test),
            // so a fix for that bug may reject it instead.
            def rejected = NfVerifyBugs.rejected(workflow.success, workflow.stdout + workflow.stderr, /(?i)control/)
            def mrp = NfVerifyBugs.tasks("${launchDir}/work", /MERGED_REPLICATE_CALL_ANNOTATE_PEAKS:MACS3_CALLPEAK/)
            assert rejected || mrp*.meta*.id.sort() == [ 'TREATED_A', 'UNTREATED_A' ] : "merged-replicate MACS3 ran for ${mrp*.meta*.id}; run success=${workflow.success}"
        }
    }
}
