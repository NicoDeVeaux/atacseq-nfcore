nextflow_workflow {

    name "nf-verify bug: zero-peak libraries are dropped from the consensus count matrix"
    script "../../workflows/atacseq.nf"
    workflow "ATACSEQ"
    config "./nextflow.config"
    tag "nf-verify-bug"
    tag "nf-verify-bug-consensus-zero-peak-libraries"

    // nf-verify R2 (silent drops): bam_peaks_call_qc_annotate_macs3_homer.nf:41-48 drops empty peak files, and
    // bed_consensus_quantify_qc_bedtools_featurecounts_deseq2.nf:63-64 inner-joins the BAMs with those peaks, so a
    // library with 0 peaks is missing from the featureCounts matrix (and DESeq2 QC) instead of counting 0 reads in peaks.
    // https://github.com/seqeralabs/nf-verify/blob/integration/docs/rules/R2-silent-drops.md
    test("consensus featureCounts counts every library, including one with zero peaks") {

        options "-stub"

        when {
            params {
                load("$baseDir/tests/nf-verify-bugs/stub_params.json")
                outdir                  = "$outputDir"
                skip_consensus_peaks    = false
                skip_merge_replicates   = true
                nf_verify_zero_peak_ids = 'WT_REP2'
            }
            workflow {
                def sheet = NfVerifyBugs.stageSamplesheet("${baseDir}/tests/nf-verify-bugs/samplesheets/zero_peak_consensus.csv", "$outputDir")
                NfVerifyBugs.atacseqInputs(sheet, "$outputDir")
            }
        }

        then {
            def counts = NfVerifyBugs.tasks("${launchDir}/work", /MERGED_LIBRARY_CONSENSUS_PEAKS:SUBREAD_FEATURECOUNTS/)
            def bams = counts*.inputs.flatten().findAll { f -> f.endsWith('.bam') }.collect { f -> f.tokenize('.')[0] }.sort()
            assertAll(
                { assert workflow.success },
                { assert counts.size() == 1 },
                { assert bams == [ 'KO_REP1', 'KO_REP2', 'WT_REP1', 'WT_REP2' ] : "featureCounts counted ${bams}" }
            )
        }
    }
}
