nextflow_pipeline {

    name "Test pipeline with --shift_reads"
    script "../main.nf"
    tag "shift_reads"

    // Exercises BAM_SHIFT_READS (DEEPTOOLS_ALIGNMENTSIEVE + samtools sort/index),
    // which no other test reaches: shift_reads defaults to false, so the whole
    // subworkflow and its conf/modules.config selectors were dead in CI.
    //
    // Requires an all-paired-end cohort. workflows/atacseq.nf exits with
    // 'The parameter --shift_reads can only be applied if all samples are
    // paired-end.' otherwise, and the default fixture is mixed SE/PE.

    test("shift_reads") {

        when {
            params {
                outdir = "$outputDir"
                input = "${projectDir}/tests/csv/all_pe_samplesheet.csv"
                shift_reads = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                // The shifted BAMs must actually be produced, otherwise this test would
                // still pass while silently skipping the subworkflow it exists to cover.
                { assert stable_name.any { it.toString().contains('.mLb.clN.sorted.bam') } },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_atacseq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("shift_reads with stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input = "${projectDir}/tests/csv/all_pe_samplesheet.csv"
                shift_reads = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }
}
